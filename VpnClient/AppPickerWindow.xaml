<Window x:Class="VpnClient.AppPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Добавить приложение" Icon="/PipidastrVPN;component/Assets/pipidastr-logo.png" Width="710" Height="590" MinWidth="570" MinHeight="450" WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" Foreground="#F4F6FF" FontFamily="Segoe UI">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Выберите запущенные приложения" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBox Grid.Row="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию или пути" Margin="0,0,0,14"/>
    <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="12" Padding="10">
      <ListBox x:Name="CandidatesList" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemTemplate="{StaticResource AppItemTemplate}"/>
    </Border>
    <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="Выбрать файл .exe…" Click="Browse_Click"/>
      <Button Grid.Column="2" Content="Отмена" Click="Cancel_Click" Margin="0,0,9,0"/>
      <Button Grid.Column="3" Content="Добавить выбранные" Background="{StaticResource Accent}" Click="Add_Click"/>
    </Grid>
  </Grid>
</Window>
